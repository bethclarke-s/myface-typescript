<html lang="en-gb">
<%- include('_head') -%>
<%- include('_header') -%>
<body>
<h1>Posts</h1>
<ol>
    <% postList.results.forEach(function(post) {%>
        <li>
            <p> New post from user <%= post.postedBy.username %> - <%= format(post.createdAt, "HH:mm, dd-MM-yyyy") %> </p>
            <%= post.message %> 
            <img src="<%= post.imageUrl %>"/>
            
            <% if(post.likedBy.length === 1) { %> <p> Liked by  <%= post.likedBy[0].name %>. </p><% } else if (post.likedBy.length > 1) { %> <p> Liked by  <%= post.likedBy[0].name %> and <%= post.likedBy.length -1 %> others. </p><% } %>

            <% if(post.dislikedBy.length === 1) { %> <p> Disliked by  <%= post.dislikedBy[0].name %>. </p><% } else if(post.dislikedBy.length > 1) { %> <p> Disliked by  <%= post.dislikedBy[0].name %> and <%= post.dislikedBy.length -1 %> others. </p><% } %>
        </li>
    <% }); %>
</ol>

<% if (postList.previous) { %> <a href="<%= postList.previous %>">Previous page</a> <% } %>
<% if (postList.next) { %> <a href="<%= postList.next %>">Next page</a> <% } %>

</body>
<%- include('_footer') -%>
</html>