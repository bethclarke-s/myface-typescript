<html lang="en-gb">
<%- include('_head') -%>
<%- include('_header') -%>
<body>
<h1>Posts</h1>
<ol>
    <% postList.results.forEach(function(post) {%>
        <li>
            <p> New post from user <%= post.userId %> - <%= format(post.createdAt, "HH:mm, dd-MM-yyyy") %> </p>
            <%= post.message %> 
            <img src="<%= post.imageUrl %>"/>
        </li>
    <% }); %>
</ol>
</body>
<%- include('_footer') -%>
</html>